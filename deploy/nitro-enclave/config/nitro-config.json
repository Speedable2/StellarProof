{
  "$schema": "https://stellarproof.dev/schemas/nitro-config.schema.json",
  "version": "1.0.0",
  "enclave": {
    "name": "StellarProof Verification Worker",
    "version": "1.0.0",
    "description": "AWS Nitro Enclave for TEE-based verification and attestation",
    "memory_mb": 512,
    "cpu_count": 2,
    "debug_mode": false,
    "kms": {
      "enabled": true,
      "algorithm": "AES-256-GCM",
      "key_derivation": "PBKDF2-SHA256"
    }
  },
  "attestation": {
    "enabled": true,
    "format": "AWS_NITRO_ATTESTATION",
    "out_of_band": {
      "enabled": true,
      "vsock_cid": 3,
      "vsock_port": 19600,
      "timeout_ms": 10000,
      "max_retries": 3,
      "retry_backoff_ms": 1000
    },
    "document": {
      "type": "cbor",
      "version": "1.0",
      "contains": [
        "pcr0",
        "pcr1",
        "pcr2",
        "timestamp",
        "certificate"
      ]
    },
    "verification": {
      "enabled": true,
      "algorithm": "ED25519",
      "keypair_storage": "enclave_memory",
      "key_rotation_days": 90
    }
  },
  "worker": {
    "type": "verification",
    "concurrency": 4,
    "max_jobs_per_cycle": 10,
    "poll_interval_ms": 5000,
    "verification_timeout_ms": 300000,
    "max_retries": 3,
    "retry_backoff_ms": 5000,
    "graceful_shutdown_timeout_ms": 30000,
    "enable_metrics": true,
    "enable_profiling": false
  },
  "security": {
    "isolation_level": "strict",
    "memory_protection": true,
    "secure_random": true,
    "crypto_acceleration": true,
    "audit_logging": true,
    "secrets_encryption": true,
    "tls": {
      "enabled": true,
      "min_version": "1.3",
      "certificate_path": "/app/.attestation/tls-cert.pem",
      "key_path": "/app/.attestation/tls-key.pem"
    }
  },
  "networking": {
    "vsock_enabled": true,
    "vsock_listen_cid": 2,
    "health_check_port": 8081,
    "health_check_interval_ms": 30000,
    "max_connections": 100,
    "connection_timeout_ms": 30000,
    "socket_buffer_size": 65536
  },
  "database": {
    "connection_pool_size": 10,
    "connection_timeout_ms": 10000,
    "idle_timeout_ms": 30000,
    "transaction_timeout_ms": 60000,
    "max_retries": 3,
    "retry_backoff_ms": 1000,
    "ssl_enabled": true,
    "ssl_cert_validation": true
  },
  "stellar": {
    "network": "testnet",
    "rpc_timeout_ms": 10000,
    "rpc_max_retries": 3,
    "rpc_failover_enabled": true,
    "transaction_confirmation_timeout_ms": 120000,
    "base_fee": 100,
    "min_sequence_number_check": true
  },
  "storage": {
    "ipfs": {
      "enabled": true,
      "timeout_ms": 30000,
      "max_retries": 2,
      "retry_backoff_ms": 500,
      "retry_backoff_multiplier": 2.0
    },
    "cloudinary": {
      "enabled": true,
      "timeout_ms": 30000,
      "max_retries": 2
    },
    "fallback_strategy": "cloudinary"
  },
  "logging": {
    "level": "info",
    "format": "json",
    "output": [
      "stdout",
      "file"
    ],
    "file": {
      "path": "/var/log/enclave-worker.log",
      "max_size_mb": 100,
      "max_files": 10,
      "compress": true
    },
    "sensitive_data_redaction": true
  },
  "monitoring": {
    "metrics": {
      "enabled": true,
      "collection_interval_ms": 60000,
      "export_interval_ms": 300000,
      "export_format": "prometheus",
      "export_endpoint": "http://localhost:9090/metrics"
    },
    "health_checks": {
      "enabled": true,
      "interval_ms": 30000,
      "timeout_ms": 5000,
      "checks": [
        "process_alive",
        "database_connectivity",
        "stellar_rpc_connectivity",
        "attestation_status",
        "memory_usage",
        "disk_space",
        "file_descriptors"
      ]
    },
    "alerts": {
      "enabled": true,
      "thresholds": {
        "memory_usage_percent": 85,
        "disk_usage_percent": 90,
        "error_rate_percent": 5,
        "verification_timeout_count": 10
      }
    }
  },
  "reliability": {
    "crash_recovery": {
      "enabled": true,
      "recovery_strategy": "resume_from_checkpoint",
      "checkpoint_interval_ms": 60000,
      "max_recovery_attempts": 5
    },
    "circuit_breaker": {
      "enabled": true,
      "failure_threshold": 5,
      "success_threshold": 2,
      "timeout_ms": 30000
    },
    "rate_limiting": {
      "enabled": true,
      "requests_per_second": 100,
      "burst_size": 200
    }
  },
  "deployment": {
    "target": "aws_nitro_enclave",
    "region": "us-east-1",
    "instance_type": "m5.large",
    "enclave_image_uri": "stellarproof/verification-worker:latest",
    "image_hash": "sha256:placeholder",
    "registry_config": {
      "type": "aws_ecr",
      "registry": "xxxxxxxxx.dkr.ecr.us-east-1.amazonaws.com"
    }
  },
  "compliance": {
    "attestation_required": true,
    "code_hash_verification": true,
    "audit_trail": true,
    "pii_encryption": true,
    "data_retention_days": 90
  }
}
