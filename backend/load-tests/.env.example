# Load Test Environment Configuration
# Copy this file to .env.local and update values for your environment

# ============================================================================
# Server Configuration
# ============================================================================
BASE_URL=http://localhost:4000
NODE_ENV=test

# ============================================================================
# Authentication
# ============================================================================
# JWT token for authenticated requests
JWT_TOKEN=

# Default test user ID
TEST_USER_ID=test-user-001

# ============================================================================
# KMS Load Test Configuration
# ============================================================================

# Virtual Users (concurrent VUs)
KMS_VUS=50

# Test Duration (format: 1s, 1m, 1h)
KMS_DURATION=5m

# Ramp-up duration
KMS_RAMP_UP=1m

# Batch configuration
KMS_BATCH_SIZE=5
KMS_CONCURRENT_BATCHES=10

# ============================================================================
# Worker Load Test Configuration
# ============================================================================

# Virtual Users (concurrent VUs)
WORKER_VUS=50

# Test Duration
WORKER_DURATION=5m

# Ramp-up duration
WORKER_RAMP_UP=1m

# Duplicate request settings
WORKER_DUPLICATE_REQUESTS=5
WORKER_DUPLICATE_DELAY=100

# ============================================================================
# General Load Test Configuration
# ============================================================================

# Think time between operations (seconds)
THINK_TIME=1

# HTTP timeout (milliseconds)
HTTP_TIMEOUT=30000

# Enable verbose logging
VERBOSE=false

# ============================================================================
# Output Configuration
# ============================================================================

# Output format: text (default), json, cloud
OUTPUT_FORMAT=text

# Results output file (for JSON output)
# OUTPUT_FILE=results.json

# ============================================================================
# Performance Thresholds
# ============================================================================

# HTTP success rate threshold (0-1)
HTTP_SUCCESS_RATE_THRESHOLD=0.95

# KMS atomicity violations allowed
KMS_ATOMICITY_FAILURES_ALLOWED=0

# Worker idempotency violations allowed
WORKER_IDEMPOTENCY_FAILURES_ALLOWED=0

# p95 response time threshold (milliseconds)
HTTP_P95_THRESHOLD=5000
